#!/bin/bash
#заглушка curl для тестов
#пишет аргументы вызова в $CURL_LOG
#отвечает по таблице $CURL_ROUTES (строки: подстрока_URL<TAB>файл_ответа),
#на неизвестный URL отвечает {}

echo "$@" >> "${CURL_LOG:-/dev/null}"

#сохранить тело -T загрузки для проверок (в $CURL_UPLOADS)
prev=""
upfile=""
for a in "$@"; do
	[ "$prev" == "-T" ] && upfile=$a
	prev=$a
done
if [ -n "$upfile" ] && [ -n "$CURL_UPLOADS" ] && [ -f "$upfile" ]; then
	mkdir -p "$CURL_UPLOADS"
	n=$(ls "$CURL_UPLOADS" 2>/dev/null | wc -l)
	cp "$upfile" "$CURL_UPLOADS/upload.$n"
fi

url=""
for a in "$@"; do
	case "$a" in
		http://*|https://*) url=$a;;
	esac
done

if [ -n "$CURL_ROUTES" ] && [ -f "$CURL_ROUTES" ]; then
	while IFS=$'\t' read -r pattern respfile; do
		[ -z "$pattern" ] && continue
		case "$url" in
			*"$pattern"*) cat "$respfile"; exit 0;;
		esac
	done < "$CURL_ROUTES"
fi

echo '{}'
