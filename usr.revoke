#!/bin/bash

if [ -z "$1" ]; then
	echo "Usage: $0 <username|list>"
	echo "username - Name of user to revoke cert"
	echo "list     - Show list of currently revoked users"
	exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib

#файл CRL: по умолчанию как в базовом варианте, multisite переопределяет в _config
crlfile=${crlfile:-./clients/revoked.crl}

function showcrl() {
	openssl crl -noout -text -in $crlfile
}

if [ "$1" == "list" ]; then
	showcrl
	exit
fi

cert=./clients/${prefix}-$1/${prefix}_$1.crt
legacycert=""
if [ ! -e "$cert" ] && [ -n "$legacyCertsDir" ]; then
	#историческая раскладка (legacyCertsDir в _config): сертификаты,
	#выданные до этих скриптов
	cert=`findCertByCN $1 $legacyCertsDir`
	legacycert=$cert
fi

if [ -z "$cert" ] || [ ! -e "$cert" ]; then
	echo "User $1 not found or revoked already"
	exit 10
fi

./usr.show $1

echo "WARINNG: user $1 certificate will be revoked!"
echo "Press Ctrl+C to abort..."
waittime="5 4 3 2 1 0"
#waittime="NOREMORSE"
for t in $waittime; do
    echo $t
    sleep 2
done

if [ ! -d ./clients/revoked ]; then
	mkdir ./clients/revoked
fi

echo "Revoking $1"

openssl ca -revoke $cert -config $sslconf || exit 20

#сертификат исторической раскладки убираем в $legacyCertsDir/revoked
if [ -n "$legacycert" ]; then
	mkdir -p $legacyCertsDir/revoked
	mv "$legacycert" $legacyCertsDir/revoked/
fi

#папку клиента (если есть) архивируем с таймстампом
if [ -d "./clients/${prefix}-$1" ]; then
	mv "./clients/${prefix}-$1" "./clients/revoked/${prefix}-$1.$(date +%F_%H-%M-%S)"
fi

openssl ca -gencrl -out $crlfile -config $sslconf

showcrl
