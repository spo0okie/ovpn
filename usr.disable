#!/bin/bash
#отключает CCD (снимает с инстанса) для конфига $1 на инстансе $2
#(или на всех инстансах, если $2 отсутствует)

if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib

user=$1
instance=${2:-}

if [ -z "$instance" ]; then
	for inst in $(getInstances); do
		ccd=$(getConfigCcd $user $inst)
		if [ -s "$ccd" ] || [ -s "$ccd.disabled" ]; then
			$SCRIPTPATH/usr.disable $user $inst
		fi
	done
	exit
fi

$SCRIPTPATH/usr.publish $user $instance disable
