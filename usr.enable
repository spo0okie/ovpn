#!/bin/bash
#включает CCD (публикует на инстанс) для конфига $1 на инстансе $2
#(или на всех инстансах, если $2 отсутствует)

if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib

user=$1
instance=${2:-}

if [ -z "$instance" ]; then
	echo "сервер не указан явно. влючаем все..."
	for inst in $(getInstances); do
		$SCRIPTPATH/usr.enable $user $inst
	done
	exit
fi

echo "включаем $user@$instance..."
$SCRIPTPATH/usr.publish $user $instance enable
