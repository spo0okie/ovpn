#!/bin/bash
#генерирует конфиг для пользователя


if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config

userdir=$SCRIPTPATH/clients/$prefix-$1
keyfile=$userdir/${prefix}_$1.key
certfile=$userdir/${prefix}_$1.crt
csrfile=$userdir/${prefix}_$1.csr
pwdfile=$userdir/passwd.txt
goofile=$userdir/google.txt

mkdir -p $userdir

if [ -s $pwdfile ]; then
	echo "Файл с паролем - ОК (уже есть)"
	pass=`cat $pwdfile`
else
	pass=""
	for i in {1..13}; do
		pass="${pass}${passLetters:RANDOM%${#passLetters}:1}"
	done
	echo $pass > $pwdfile
	echo "Файл с паролем - ОК"
fi


if [ -s $goofile ]; then
	echo "Файл Google-auth - ОК (уже есть)"
else
	# -t --time-based
	# -f --force
	# -r --rate-limit=5 - не больше 5 попыток
	# -R --rate-time=30 - за каждые 60 секунд
	# -w --windows-size - разрешить входить по 5 предыдущим и 5 следующим ключам
	# -S --step-size=60 - новый ключ каждые 60 секунд
	# -Q --qr-mode=none - не выводить QR код
	# -D --allow-reuse  - разрешить 2 раза входить по одному и тому же ключу
	# -q --quiet
	google-authenticator -f -t -r 3 -R 30 -w 5 -Q none -D -q --secret=$goofile
	echo "Файл Google-auth - ОК"
fi


if [ -s $keyfile ]; then
	echo "Приватный ключ - ОК (уже есть)"
else
	echo "Приватный ключ - Генерирую"
	openssl genrsa -aes256 -out $keyfile -passout file:$pwdfile
	if [ ! -e $keyfile ]; then
		echo "Приватный ключ - ОШИБКА"
		exit 10
	else
		echo "Приватный ключ - ОК"
	fi
fi


if [ -s $certfile ]; then
	echo "Файл сертификата - ОК (уже есть)"
else
	if [ -s $csrfile ]; then
		echo "Файл запроса сертификата - ОК (уже есть)"
	else
		echo "Файл запроса сертификата - Генерирую"
		echo -e "RU\nUral\nChel\n$org\nIT\n$1\n\n\n" |openssl req -config $sslconf -new -nodes -key $keyfile -out $csrfile -passin file:$pwdfile
		if [ ! -e $csrfile ]; then
			echo "Файл запроса сертификата - ОШИБКА"
			exit 20
		fi
	fi
	echo "Файл сертификата - Генерирую"
	openssl ca -batch -extensions client_cert -in $csrfile -out $certfile -config $sslconf
	if [ ! -e $certfile ]; then
		echo "Файл сертификата - ОШИБКА"
		exit 30
	fi
fi


# Блок создания OpenVPN конфига

for site in $sites; do
	#echo $SCRIPTPATH/_ccd.check $1 $site
	site_mode=`$SCRIPTPATH/_ccd.check $1 $site`
	#echo "$site_mode"	
	case "$site_mode" in
		OVPN)
			echo Готовлю OpenVPN конфиг для $site
			CONF=$userdir/${prefix}_${1}_${site}.ovpn

			>$CONF
			echo "dev		tun"		>>$CONF
			echo "port		$port"		>>$CONF
			echo "proto		$proto"		>>$CONF
			echo "nobind"				>>$CONF

			for postfix in $srvpostfix; do
				srvaddr="${site}${postfix}"
				echo "remote	$srvaddr"	>>$CONF
			done
			echo "resolv-retry infinite">>$CONF
			echo "client">>$CONF
			echo "tls-client"			>>$CONF

			echo "<ca>"					>>$CONF
			cat $SCRIPTPATH/cacert.pem	>>$CONF
			echo "</ca>"				>>$CONF
			echo "<cert>"				>>$CONF
			cat $certfile				>>$CONF
			echo "</cert>"				>>$CONF
			echo "<key>"				>>$CONF
			cat $keyfile				>>$CONF
			echo "</key>"				>>$CONF
			echo "tls-auth [inline] 1"	>>$CONF
			echo "<tls-auth>"			>>$CONF
			cat $SCRIPTPATH/ta.key		>>$CONF
			echo "</tls-auth>"			>>$CONF
			echo "cipher $cipher"		>>$CONF
			#echo "persist-key"			>>$CONF
			#echo "persist-tun"			>>$CONF
			echo "ping 10"				>>$CONF
			echo "mssfix 1400"			>>$CONF
			echo "comp-lzo"				>>$CONF
			echo "verb 3"				>>$CONF
			dns_var=${site}_dns
			dns_addr=${!dns_var}
			#echo "dhcp-option DNS ${dns_addr}">>$CONF
			rm -f $userdir/${prefix}_${1}_${site}_2fa.ovpn
			;;
		OVPN2FA)
			echo Готовлю OpenVPN конфиг для $site
			CONF=$userdir/${prefix}_${1}_${site}_2fa.ovpn

			>$CONF
			echo "dev		tun"		>>$CONF
			echo "port		$port2fa"	>>$CONF
			echo "proto		$proto"		>>$CONF
			echo "nobind"				>>$CONF

			for postfix in $srvpostfix; do
				srvaddr="${site}${postfix}"
				echo "remote	$srvaddr"	>>$CONF
			done
			echo "resolv-retry infinite">>$CONF
			echo "client">>$CONF
			echo "tls-client"			>>$CONF

			echo "<ca>"					>>$CONF
			cat $SCRIPTPATH/cacert.pem	>>$CONF
			echo "</ca>"				>>$CONF
			echo "<cert>"				>>$CONF
			cat $certfile				>>$CONF
			echo "</cert>"				>>$CONF
			echo "<key>"				>>$CONF
			cat $keyfile				>>$CONF
			echo "</key>"				>>$CONF
			echo "tls-auth [inline] 1"	>>$CONF
			echo "<tls-auth>"			>>$CONF
			cat $SCRIPTPATH/ta.key		>>$CONF
			echo "</tls-auth>"			>>$CONF
			echo "cipher $cipher"		>>$CONF
			#echo "persist-key"			>>$CONF
			#echo "persist-tun"			>>$CONF
			echo "ping 10"				>>$CONF
			echo "mssfix 1400"			>>$CONF
			echo "comp-lzo"				>>$CONF
			echo "verb 3"				>>$CONF
			dns_var=${site}_dns
			dns_addr=${!dns_var}
			#echo "dhcp-option DNS ${dns_addr}">>$CONF
			echo "auth-user-pass"		>>$CONF
			echo "auth-nocache"			>>$CONF
			echo "reneg-sec 0"			>>$CONF
			rm -f $userdir/${prefix}_${1}_${site}.ovpn
			;;
		NONE)
			echo "$site не используется"
			rm -f $userdir/${prefix}_${1}_${site}.ovpn
			rm -f $userdir/${prefix}_${1}_${site}_2fa.ovpn
			;;
		*)
			#какая-то ошибка вместо выбора типа подключения
			echo $site_mode
			rm -f $userdir/${prefix}_${1}_${site}.ovpn
			rm -f $userdir/${prefix}_${1}_${site}_2fa.ovpn
	esac
done

echo "OpenVPN конфигурация готова"

#Конец Блока создания OpenVPN конфига

# Блок создания OpenVPN Connect конфига

for site in $sites; do
    #echo $SCRIPTPATH/_ccd.check $1 $site
    site_mode=`$SCRIPTPATH/_ccd.check $1 $site`
    #echo "$site_mode" 
    case "$site_mode" in
        OVPN)
            echo Готовлю OpenVPN конфиг для $site
            CONF=$userdir/${prefix}_${1}_${site}_connect.ovpn

            >$CONF
            echo "client" >>$CONF
            echo "dev tun" >>$CONF
            for postfix in $srvpostfix; do
                srvaddr="${site}${postfix}"
                echo "remote $srvaddr $port $proto" >>$CONF
            done
            echo "tls-client"  >>$CONF
            echo "nobind"  >>$CONF
            echo "ping 10" >>$CONF
            echo "mssfix 1400" >>$CONF
            echo "comp-lzo" >>$CONF
            echo "verb 3" >>$CONF
            echo "cipher $cipher" >>$CONF
            echo "resolv-retry infinite" >>$CONF
            echo "key-direction 1" >>$CONF
            echo "<ca>" >>$CONF
            cat $SCRIPTPATH/cacert.pem >>$CONF
            echo "</ca>" >>$CONF
            echo "<cert>" >>$CONF
            cat $certfile >>$CONF
            echo "</cert>" >>$CONF
            echo "<key>" >>$CONF
            cat $keyfile >>$CONF
            echo "</key>" >>$CONF
            echo "<tls-auth>" >>$CONF
            cat $SCRIPTPATH/ta.key  >>$CONF
            echo "</tls-auth>"  >>$CONF
            rm -f $userdir/${prefix}_${1}_${site}_2fa_connect.ovpn
            ;;
        OVPN2FA)
            echo Готовлю OpenVPN конфиг для $site
            CONF=$userdir/${prefix}_${1}_${site}_2fa_connect.ovpn

            >$CONF

            echo "client" >>$CONF
            echo "dev tun" >>$CONF
            for postfix in $srvpostfix; do
                srvaddr="${site}${postfix}"
                echo "remote $srvaddr $port2fa $proto" >>$CONF
            done
            echo "tls-client"  >>$CONF
            echo "nobind"  >>$CONF
            echo "ping 10" >>$CONF
            echo "mssfix 1400" >>$CONF
            echo "comp-lzo" >>$CONF
            echo "verb 3" >>$CONF
            echo "cipher $cipher" >>$CONF
            echo "auth-user-pass" >>$CONF
            echo "auth-nocache" >>$CONF
            echo "reneg-sec 0" >>$CONF
            echo "resolv-retry infinite" >>$CONF
            echo "key-direction 1" >>$CONF

            echo "<ca>" >>$CONF
            cat $SCRIPTPATH/cacert.pem >>$CONF
            echo "</ca>" >>$CONF
            echo "<cert>" >>$CONF
            cat $certfile >>$CONF
            echo "</cert>" >>$CONF
            echo "<key>" >>$CONF
            cat $keyfile >>$CONF
            echo "</key>" >>$CONF
            echo "<tls-auth>" >>$CONF
            cat $SCRIPTPATH/ta.key >>$CONF
            echo "</tls-auth>" >>$CONF
            rm -f $userdir/${prefix}_${1}_${site}_connect.ovpn
            ;;
        NONE)
            echo "$site не используется"
            rm -f $userdir/${prefix}_${1}_${site}_connect.ovpn
            rm -f $userdir/${prefix}_${1}_${site}_2fa_connect.ovpn
            ;;
        *)
            #какаято ошибка вместо выбора типа подключения
            echo $site_mode
            rm -f $userdir/${prefix}_${1}_${site}_connect.ovpn
            rm -f $userdir/${prefix}_${1}_${site}_2fa_connect.ovpn
    esac
done

echo "OpenVPN Connect конфигурация готова"

# Конец Блока создания OpenVPN Connect конфига