#!/bin/bash
#генерирует CCD файл для пользователя $1 в площадке $2
#только в сети 2FA, т.к. другие сейчас не генерируем


if [ -z "$1" ]; then
	echo "No username given"
	exit
fi

if [ -z "$2" ]; then
	echo "No site given"
	exit
fi
site=$2

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib
. $SCRIPTPATH/_lib.inv

vpnnet_var=${site}_openvpn_lan
vpnnet=${!vpnnet_var}

userdir=$SCRIPTPATH/clients/$prefix-$1

site=$2
ccd=$userdir/ccd.${site}

user=`getConfigUser $1`


if [ -s $ccd ] || [ -s $ccd.disabled ]; then
	echo "CCD файл уже есть"
else
	if [ -n "$inventoryApiUrl" ]; then

		echo "Ищу IP закрепленный за конфигом ovpn-$1"
		addr=`inventoryGetPinnedIp ovpn-$1`
		if [ "$addr" == "null" ]; then
			echo "Не нашел, ищу свободный адрес в сети $vpnnet"
			addr=`inventoryGetUnusedIp $vpnnet`
			if [ "$addr" == "null" ]; then
				echo "HALT: ERR не могу получить свободный IP!"
				exit 10
			fi
		fi

		if [ -z "$addr" ]; then
			echo "HALT: ERR не могу получить IP для CCD!"
			exit 10
		else
			addr2fa=`normalTo2faIp $addr $site`
			echo "Получил адрес $addr ($addr2fa)"
			mask=`networkSuffix $vpnnet`
			addr=`suffix2mask $addr/$mask`
		fi
		echo "ifconfig-push $( suffix2mask $addr2fa/$mask )" > $ccd
	else
		echo "Creating empty CCD"
		touch $ccd
	fi

	echo "Создан файл $ccd"
	octetRoute=`suffix2mask $vpnnet`
	echo "push \"route $octetRoute\"" >> $ccd
	for netw in $push_routes; do
		octetRoute=`suffix2mask $netw`
		echo "push \"route $octetRoute\"" >> $ccd
	done
fi
