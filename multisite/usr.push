#!/bin/bash
#отправляет данные конфига $1 на сервер сайта $2 (или на все если сайт не указан)

if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib


if [ -z "$2" ]; then
	for site in $sites; do
		$SCRIPTPATH/usr.push $1 $site
	done
	exit
fi

site=$2
$SCRIPTPATH/usr.push.inv $1 $2

userdir=$(getConfigDir $1)
goofile=$userdir/google.txt
server=${site}${sshpostfix}
ccd=$(getConfigCcd $1 $2)
ccdfile="$remoteCcdDir/$1"
if [ -s $ccd ]; then
	echo "Включаю клиента на сервере $site"
	ccdata=`cat $ccd`
	ssh -i $rsynckeyfile root@$server "echo '$ccdata' > $ccdfile && rm -f ${ccdfile}_OFF"
	if [ -f "$goofile" ]; then
		goodata=`cat $goofile`
		ssh -i $rsynckeyfile root@$server "mkdir -p $remoteGauthDir/$1/ && echo '$goodata' > $remoteGauthDir/$1/.google_auth && chmod 600 $remoteGauthDir/$1/.google_auth"
	fi
else
	echo "Выключаю клиента на сервере $site"
	ssh -i $rsynckeyfile root@$server "test -e $ccdfile && mv -f $ccdfile ${ccdfile}_OFF"
fi

