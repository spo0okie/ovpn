#!/bin/bash
#включает CCD файл для конфига $1 в сайте $2 (или везде если $2 отсутствует)
#только в сети 2FA, т.к. другие сейчас не генерируем

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib
. $SCRIPTPATH/_lib.inv


if [ -z "$1" ]; then
	echo "No username given"
	exit
fi


if [ -z "$2" ]; then
	for site in $sites; do
		$SCRIPTPATH/usr.enable $1 $site
	done
	exit
fi

site=$2

ccd=$(getConfigCcd $1 $2)
if [ -s $ccd.disabled ]; then
	echo Включаю CCD $1 для сервера $site
	mv $ccd.disabled $ccd
	$SCRIPTPATH/usr.push $1 $site
fi
