#!/bin/sh
#v1.0.3
#Файл конфигурации скриптов управления OpenVPN 
#сервера для режима клиент-сервер

#Полное имя организации (для записи в сертификаты)
org=SampleOrg

#префиксы генерируемых файлов (персонализация по организации)
prefix=Smpl

#имя сервера для CA
srvname=$prefix-server

#Адрес для подключения клиентов
srvaddr=ovpn.sampleorg.ru

#protocol and port
proto=udp
port=5100

#VPN подсеть куда будут помещены клиенты
vpnnet=192.168.77.0/24

#предыдущая подсеть клиентов (для массового обновления CCD при смене подсети)
#если не задана - считается равной vpnnet (обновления не будет)
#previousVpnnet=192.168.77.0/24

#which networks route over vpn
subnets="192.168.77.0/24 172.20.0.0/16"

#предыдущий состав подсетей. если текущий CCD соответствует им,
#то CCD будет автоматически обновлен до $subnets
#если не заданы - считаются равными subnets (обновления не будет)
#previousSubnets="192.168.77.0/24 172.20.0.0/16"

#which dns servers to push
dns="192.168.77.2 172.20.20.2"

#2FA: use2fa=1 включает генерацию секрета Google Authenticator
#(google.txt в папке клиента) при создании пользователя.
#требует установленного google-authenticator (libpam-google-authenticator)
#use2fa=0

ovpndir=/etc/openvpn/server

sslconf=$ovpndir/openssl.cnf

#файл CRL (закомментировано = значение по умолчанию)
#crlfile=./clients/revoked.crl

#каталог сертификатов исторической раскладки (см. multisite/_config.sample);
#в базовом варианте выключено - ./certs занят под new_certs_dir openssl
#legacyCertsDir=

#если укахзан, то будет хранить адреса пользователей в инвентори
#если инвентори требует авторизацию - логин/пароль указываются прямо в URL
#inventoryApiUrl=https://user:password@inventory.sampleOrg.local/web/api
inventoryApiUrl=https://inventory.sampleOrg.local/web/api

#пароль на приватный ключ клиента: usePassKey=1 - ключ шифруется (aes256),
#пароль генерируется в passwd.txt в папке клиента
#usePassKey=0
#passLetters="abcdefghjkmnopqrstuvwxyzABCDEFJHJKLMNPQRSTUVWXYZ23456789"

#makeConnectConf=1 - дополнительно генерировать конфиг для OpenVPN Connect
#(*_connect.ovpn: remote одной строкой с портом и протоколом)
#makeConnectConf=0

#доставка конфигов пользователям (usr.send): если задан nextcloudUrl -
#конфиги выкладываются в Nextcloud и шарятся пользователю;
#если задан и smsApiUrl - пароль ключа и секрет 2FA уходят по СМС
#nextcloudUrl=https://nextcloud.sampleorg.ru
#adUser=vpnbot
#adPassword=SecretPassword
#nextCloudUID=00000000-0000-0000-0000-000000000000
#smsApiUrl=https://sms-gw.sampleorg.local:8082/sms/send

#почтовая доставка (usr.send, вместо Nextcloud - когда он недоступен снаружи):
#smtps:// - неявный TLS (465); smtp://host:587 - STARTTLS (принуждается
#автоматически при заданном mailUser; mailInsecure=1 отключает для
#внутренних релеев). адрес получателя берется из инвентори (Email)
#или вторым аргументом usr.send
#mailSmtpUrl=smtps://smtp.provider.com:465
#mailUser=vpn@sampleorg.ru
#mailPassword=SmtpSecret
#mailFrom=vpn@sampleorg.ru
