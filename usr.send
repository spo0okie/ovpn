#!/bin/bash
#доставка конфигов пользователю + пароли/ключи по СМС
#опциональный модуль, транспорт выбирается по _config:
# nextcloudUrl - шара в Nextcloud (приоритетный)
# mailSmtpUrl  - отправка на почту (когда Nextcloud недоступен снаружи)
# smsApiUrl    - СМС с паролем ключа и секретом 2FA (вторым каналом)
# $1 - имя конфига
# $2,$3 - (опционально, в любом порядке):
#      имя инстанса из $instances - отправить конфиги только этого инстанса
#      (имя инстанса распознается раньше логина - логин, совпадающий с
#      именем инстанса, передать нельзя);
#      иначе - логин получателя, если отличается от имени конфига

if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib

if [ -z "$nextcloudUrl" ] && [ -z "$mailSmtpUrl" ]; then
	echo "ни nextcloudUrl, ни mailSmtpUrl не заданы в _config - доставка конфигов не настроена"
	exit 1
fi

userdir=$(getConfigDir $1)
pwdfile=$userdir/passwd.txt
goofile=$userdir/google.txt

sharee=$1
sendInstance=""
knownInstances=" $(getInstances) "
for arg in "$2" "$3"; do
	[ -z "$arg" ] && continue
	if [[ "$knownInstances" == *" $arg "* ]]; then
		sendInstance=$arg
	else
		sharee=$arg
	fi
done

confList=""
if [ -n "$sendInstance" ]; then
	#только конфиги указанного инстанса. Точные имена, глобом нельзя:
	#имена инстансов пересекаются по префиксу (local и local-2fa)
	confBase=$userdir/${prefix}_$1$(instConfSuffix "$sendInstance")
	for conf in "$confBase.ovpn" "${confBase}_connect.ovpn"; do
		[ -e "$conf" ] || continue
		confList="$confList $conf"
	done
	if [ -z "$confList" ]; then
		echo "У пользователя $1 нет конфигов инстанса $sendInstance - нечего отправлять"
		exit 11
	fi
else
	#все сгенерированные конфиги пользователя (usr.new сам создает конфиг
	#на каждый инстанс, так что в папке только актуальные)
	for conf in $userdir/*.ovpn; do
		[ -e "$conf" ] || continue
		confList="$confList $conf"
	done
	if [ -z "$confList" ]; then
		echo "У пользователя $1 нет ни одного .ovpn конфига - нечего отправлять"
		exit 11
	fi
fi

#Определяем требования по фактически отправляемым конфигам, а не только по
#наличию файлов с секретами: они могут остаться от предыдущей конфигурации.
requiresKeyPassword=0
requires2fa=0
for conf in $confList; do
	if sed -n '/<key>/,/<\/key>/p' "$conf" | grep -Eq 'ENCRYPTED|Proc-Type: 4,ENCRYPTED'; then
		requiresKeyPassword=1
	fi
	if grep -Eq '^[[:space:]]*auth-user-pass([[:space:]]|$)' "$conf"; then
		requires2fa=1
	fi
done

#СМС анонсируем и отправляем только если соответствующий секрет нужен хотя
#бы одному вложению и канал СМС с самим секретом доступен.
sendKeyPasswordSms=0
[ "$requiresKeyPassword" = "1" ] && [ -n "$smsApiUrl" ] && [ -s "$pwdfile" ] && sendKeyPasswordSms=1
send2faSms=0
[ "$requires2fa" = "1" ] && [ -n "$smsApiUrl" ] && [ -s "$goofile" ] && send2faSms=1

if [ -n "$nextcloudUrl" ]; then

#путь к файлохранилищу vpnBot
apiUrl=$nextcloudUrl/remote.php/dav/files/$nextCloudUID
#создаем папки OpenVPN И пользователя
curl -k -s -u $adUser:$adPassword -X MKCOL $apiUrl/openvpn >> /dev/null
curl -k -s -u $adUser:$adPassword -X MKCOL $apiUrl/openvpn/$1 >> /dev/null

#инструкции для пользователя (если приложены в send_files/)
for doc in $SCRIPTPATH/send_files/*; do
	[ -e "$doc" ] || continue
	curl -k -s -S -u $adUser:$adPassword -X PUT "$apiUrl/openvpn/$1/$(basename "$doc")" -T "$doc"
done

for conf in $confList; do
	echo "Закидываю $(basename $conf) в NEXTCLOUD"
	curl -k -s -u $adUser:$adPassword -X PUT $apiUrl/openvpn/$1/$(basename $conf) --data-binary @$conf >> /dev/null
done

curl -k -s -u $adUser:$adPassword -H "Accept: application/json" -X PROPFIND $apiUrl/openvpn/$1 | sed 's/<\/*d:href>/\n/g' | grep remote.php | cut -d'/' -f8 | grep -v '^$' > $userdir/nextcloud.txt
filesCount=`cat $userdir/nextcloud.txt | wc -l`

echo "пользователю предоставляется $filesCount конфигурационных файлов"
if [ -z "$filesCount" ] || [ "$filesCount" -le 0 ]; then
	echo "Почему файлов то нет??? Проверяй, что-то пошло не так. Не буду дальше работать"
	exit 11
fi

ocsUrl=$nextcloudUrl/ocs/v2.php/apps/files_sharing/api/v1

search=`curl -k -s -H "OCS-APIRequest: true" -u $adUser:$adPassword "$ocsUrl/sharees?format=json&lookup=false&itemType=folder&search=$sharee"`
#echo $search |jq .ocs.data.users

users=`echo $search |jq .ocs.data.exact.users`
usersCount=`echo $users |jq length`
if [ -z "$usersCount" ] || [ "$usersCount" -le 0 ]; then
	users=`echo $search |jq .ocs.data.users`
	usersCount=`echo $users |jq length`
fi

if [ -z "$usersCount" ] || [ "$usersCount" -gt 0 ]; then
	maxUser=$(($usersCount - 1))
	for i in $(seq 0 $maxUser); do
		testUser=`echo $users |jq .[$i]`
		userLabel=`echo $testUser | jq .label | grep "($sharee)"`
		if [ -n "$userLabel" ]; then
			userId=`echo $testUser | jq -r .value.shareWith`
			userEmail=`echo $testUser | jq .shareWithDisplayNameUnique`
		fi
	done
fi

if [ -z "$userId" ]; then
	echo "Не удалось найти пользователя $sharee в Nextcloud. Не могу отправить ему конфиг"
	echo $search |jq .ocs
	exit 10
else
	echo "Пользователь $sharee найден в Nextcloud с UUID=$userId"
fi

curl -k -s -H "OCS-APIRequest: true" -d "path=/openvpn/$1&shareType=0&shareWith=$userId" -u $adUser:$adPassword $ocsUrl/shares > /dev/null
echo "Config share - Готово"

else
#================= доставка почтой =================

#адрес получателя - из инвентори по логину
invUserMail=`curl -k -s "$inventoryApiUrl/users/search?login=$sharee"`
rcptEmail=`echo $invUserMail|jq -r .Email`
if [ "$rcptEmail" == "null" ] || [ -z "$rcptEmail" ]; then
	echo "не могу найти e-mail для пользователя $sharee - отправка почтой невозможна"
	echo "проверь что такой пользователь есть в инвентори и у него прописан e-mail"
	exit 31
fi

mailFrom=${mailFrom:-$mailUser}
if [ -z "$mailFrom" ]; then
	echo "mailFrom не задан в _config - не от кого отправлять"
	exit 32
fi

echo "Конфиги будут отправлены на $rcptEmail"

boundary="ovpnPart$RANDOM$RANDOM"
mime=`mktemp`

#вложение $1 в письмо
function mimeAttach() {
	echo "--$boundary"
	echo "Content-Type: application/octet-stream; name=\"$(basename "$1")\""
	echo "Content-Disposition: attachment; filename=\"$(basename "$1")\""
	echo "Content-Transfer-Encoding: base64"
	echo
	base64 "$1"
	echo
}

{
	echo "From: $mailFrom"
	echo "To: $rcptEmail"
	mailTopic="Конфигурация OpenVPN ($1)"
	[ -n "$sendInstance" ] && mailTopic="Конфигурация OpenVPN ($1, $sendInstance)"
	echo "Subject: =?UTF-8?B?$(printf '%s' "$mailTopic" | base64 -w0)?="
	echo "Date: $(date -R)"
	echo "Message-ID: <ovpn-$1-$(date +%s)-$RANDOM@$(hostname)>"
	echo "MIME-Version: 1.0"
	echo "Content-Type: multipart/mixed; boundary=\"$boundary\""
	echo
	echo "--$boundary"
	echo "Content-Type: text/plain; charset=utf-8"
	echo "Content-Transfer-Encoding: base64"
	echo
	mailText="Файлы конфигурации OpenVPN во вложении."
	if [ "$requiresKeyPassword" = "1" ]; then
		mailText="$mailText
Для подключения потребуется пароль приватного ключа."
		[ "$sendKeyPasswordSms" = "1" ] && mailText="$mailText
Пароль приватного ключа придёт отдельным СМС-сообщением."
	fi
	if [ "$requires2fa" = "1" ]; then
		mailText="$mailText
Для подключения потребуется код двухфакторной аутентификации."
		[ "$send2faSms" = "1" ] && mailText="$mailText
Секрет двухфакторной аутентификации придёт отдельным СМС-сообщением."
	fi
	printf '%s' "$mailText" | base64
	echo

	#инструкции для пользователя (если приложены в send_files/)
	for doc in $SCRIPTPATH/send_files/*; do
		[ -e "$doc" ] || continue
		mimeAttach "$doc"
	done

	for conf in $confList; do
		echo "Прикладываю $(basename $conf) к письму" >&2
		mimeAttach "$conf"
	done

	echo "--$boundary--"
} > $mime

#авторизация открытым текстом недопустима: при заданном mailUser на
#smtp:// принуждаем STARTTLS (mailInsecure=1 отключает для внутренних релеев)
mailOpts=""
case "$mailSmtpUrl" in
	smtp://*)
		if [ -n "$mailUser" ] && [ "$mailInsecure" != "1" ]; then
			mailOpts="--ssl-reqd"
		fi
	;;
esac
[ "$mailInsecure" == "1" ] && mailOpts="$mailOpts -k"
authOpt=()
[ -n "$mailUser" ] && authOpt=(--user "$mailUser:$mailPassword")

if ! curl -s -S $mailOpts "${authOpt[@]}" --mail-from "$mailFrom" --mail-rcpt "$rcptEmail" -T $mime "$mailSmtpUrl"; then
	rm -f $mime
	echo "не удалось отправить письмо через $mailSmtpUrl"
	exit 12
fi
rm -f $mime
userLabel=$rcptEmail
echo "Письмо с конфигами - Готово"

fi
#================= конец транспортов =================


if [ "$requiresKeyPassword" != "1" ] && [ "$requires2fa" != "1" ]; then
	echo "Для отправленных конфигов передача секретов не требуется"
	exit 0
fi

if [ -z "$smsApiUrl" ]; then
	if [ "$requiresKeyPassword" = "1" ]; then
		echo "Для отправленных конфигов требуется пароль приватного ключа, но smsApiUrl не задан — СМС с паролем не отправлено"
	fi
	if [ "$requires2fa" = "1" ]; then
		echo "Для отправленных конфигов требуется 2FA, но smsApiUrl не задан — СМС с ключом Google Authenticator не отправлено"
	fi
	exit 0
fi

if [ "$sendKeyPasswordSms" != "1" ] && [ "$send2faSms" != "1" ]; then
	if [ "$requiresKeyPassword" = "1" ]; then
		echo "Для отправленных конфигов требуется пароль приватного ключа, но файл $pwdfile отсутствует или пуст — СМС с паролем не отправлено"
	fi
	if [ "$requires2fa" = "1" ]; then
		echo "Для отправленных конфигов требуется 2FA, но файл $goofile отсутствует или пуст — СМС с ключом Google Authenticator не отправлено"
	fi
	exit 0
fi

#телефон нужен только для СМС
if [ -n "$smsApiUrl" ]; then
	invUser=`curl -k -s "$inventoryApiUrl/users/search?login=$sharee&expand=private_phone"`
	mobile=`echo $invUser|jq -r .Mobile`
	if [ "$mobile" == "null" ] || [ -z "$mobile" ] ; then
		mobile=`echo $invUser|jq -r .private_phone`
	fi
	if [ "$mobile" == "null" ] || [ -z "$mobile" ] ; then
		echo "не могу найти сотовый для пользователя $sharee - отправка СМС невозможна"
		echo "проверь что такой пользователь есть в инвентори и у него прописан сотовый или личный телефон"
		exit 30
	fi
	fixMobile=`echo $mobile | sed 's/^\+7/8/' | tr -cd '[:digit:]'`
	echo "Пользователь $sharee найден в инвентори с сотовым $mobile -> $fixMobile"
fi

#отправка СМС на $fixMobile: $1 - текст. Проверяются и результат curl
#(закрытый порт, DNS), и HTTP-код шлюза - раньше оба случая проходили молча
smsFailed=0
function sendSms() {
	local bodyf errf code rc
	bodyf=`mktemp`
	errf=`mktemp`
	code=$(curl -k -sS -G --data-urlencode "text=$1" -o "$bodyf" -w '%{http_code}' "$smsApiUrl/$fixMobile" 2>"$errf")
	rc=$?
	if [ $rc -ne 0 ]; then
		echo "ОШИБКА: СМС не отправлена - шлюз $smsApiUrl недоступен: $(cat $errf)"
		rm -f $bodyf $errf
		return 1
	fi
	if [ "$code" -lt 200 ] || [ "$code" -ge 300 ]; then
		echo "ОШИБКА: СМС не отправлена - шлюз ответил HTTP $code: $(head -c 300 $bodyf)"
		rm -f $bodyf $errf
		return 1
	fi
	echo "СМС отправлена (HTTP $code): $(head -c 200 $bodyf)"
	rm -f $bodyf $errf
	return 0
}

if [ "$sendKeyPasswordSms" != "1" ]; then
	if [ "$requiresKeyPassword" = "1" ]; then
		echo "Для отправленных конфигов требуется пароль приватного ключа, но файл $pwdfile отсутствует или пуст — СМС с паролем не отправлено"
	else
		echo "Для отправленных конфигов пароль приватного ключа не требуется — СМС с паролем не отправляется"
	fi
else
	pass=`cat $pwdfile`
	echo "СМС с паролем на конфиг ($pass) будет отправлена пользоватею $userLabel, на номер $fixMobile"
	echo "Для отмены нажмите Ctrl+C"
	for i in {5..1}; do
		echo "Отпрвка через $i секунд..."
		sleep 1
	done
	sendSms "пароль на openvpn $pass" || smsFailed=1
fi

if [ "$send2faSms" != "1" ]; then
	if [ "$requires2fa" = "1" ]; then
		echo "Для отправленных конфигов требуется 2FA, но файл $goofile отсутствует или пуст — СМС с ключом Google Authenticator не отправлено"
	else
		echo "Для отправленных конфигов 2FA не требуется — СМС с ключом Google Authenticator не отправляется"
	fi
else
	pass=`cat $goofile | head -n 1`
	echo "СМС с ключом Google ($pass) будет отправлена пользоватею $userLabel, на номер $fixMobile"
	echo "Для отмены нажмите Ctrl+C"
	for i in {5..1}; do
		echo "Отпрвка чере $i секунд..."
		sleep 1
	done
	sendSms "Ключ Google $pass" || smsFailed=1
fi

if [ "$smsFailed" = "1" ]; then
	echo "ВНИМАНИЕ: не все СМС отправлены - без секретов пользователь конфигом воспользоваться не сможет"
	exit 40
fi
