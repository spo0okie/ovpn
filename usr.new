#!/bin/bash

if [ -z "$1" ]; then
    echo "No username given"
    exit
fi

#подключаем конфиг и либы
SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib
. $SCRIPTPATH/_lib.inv


#если надо сгенерит CA
if [ $1 = ca ]; then
	openssl x509 -in ./ca.pem -days 3650 -out ca_new.pem -signkey ./ca.key
	echo "New CA certificate stored in ca_new.pem"
	exit
fi

#если надо сгенерить серверный серт
if [ $1 = serv ]; then
	openssl genrsa -out ${prefix}-$1.key
	echo -e "RU\nUral\nChel\n$org\nIT\n$srvname\n\n\n" |openssl req -config $sslconf -new -nodes -key ${prefix}-$1.key -out ${prefix}-$1.csr -sha256
	openssl ca -batch -in ${prefix}-$1.csr -out ${prefix}-$1.crt -config $sslconf
	exit
fi

#генерим пользователя
user=$1
shift

#грузим остальные параметры
instance=""
noupdate=""
for arg in "$@"; do
	if [ "$arg" = "noupdate" ]; then
		noupdate=1
	else
		instance=$arg
	fi
done

#cipher: из server.conf (одиночный инстанс), иначе из $cipher / дефолт
cipher=`cat $ovpndir/server.conf 2>/dev/null | grep -E "^cipher" | cut -d ' ' -f2`
[ -z "$cipher" ] && cipher=${cipher:-AES-256-CBC}

#общие для всех инстансов пути
userdir=$ovpndir/clients/$prefix-$user
keyfile=$userdir/${prefix}_$user.key
certfile=$userdir/${prefix}_$user.crt
csrfile=$userdir/${prefix}_$user.csr
goofile=$userdir/google.txt

mkdir -p $userdir

#пароль на приватный ключ (usePassKey=1 в _config)
if [ "$usePassKey" = "1" ]; then
	pwdfile=$userdir/passwd.txt
	if [ -s $pwdfile ]; then
		echo "password file already exists"
	else
		echo "generating password file"
		passLetters=${passLetters:-"abcdefghjkmnopqrstuvwxyzABCDEFJHJKLMNPQRSTUVWXYZ23456789"}
		pass=""
		for i in {1..13}; do
			pass="${pass}${passLetters:RANDOM%${#passLetters}:1}"
		done
		echo $pass > $pwdfile
		chmod 600 $pwdfile
	fi
	passinOpt="-passin file:$pwdfile"
else
	passinOpt=""
fi

#ключ к сертификату
if [ -s $keyfile ]; then
	echo "keyfile already exists"
else
	echo "generatating keyfile"
	if [ "$usePassKey" = "1" ]; then
		openssl genrsa -aes256 -out $keyfile -passout file:$pwdfile
	else
		openssl genrsa -out $keyfile
	fi
fi

#сертификат
if [ -s $certfile ]; then
	echo "cert file already exists"
else
	if [ -s $certfile ]; then
		echo "cert request file already exists"
	else
		echo "generating cert request"
		echo -e "RU\nUral\nChel\n$org\nIT\n$user\n\n\n" |openssl req -config $sslconf -new -nodes -key $keyfile $passinOpt -out $csrfile
	fi
	echo "generating cert file"
	openssl ca -batch -in $csrfile -out $certfile  -config $sslconf
fi

#CCD: генерация/обновление вынесены в usr.gen.ccd (noupdate пробрасывается)
if [ -n "$instance" ]; then
	instances_list=$instance
else
	instances_list=$(getInstances)
fi

for inst in $instances_list; do
	args="$user $inst"
	[ -n "$noupdate" ] && args="$args noupdate"
	$SCRIPTPATH/usr.gen.ccd $args || exit $?
done

#конфиг на каждый инстанс, у которого есть CCD
need2fa=0
for inst in $instances_list; do
	ccd=$(getConfigCcd $user $inst)
	if [ ! -s "$ccd" ]; then
		continue
	fi

	if [ "$(inst_var $inst auth_mode)" = "2fa" ]; then
		need2fa=1
	fi

	confBase=$userdir/${prefix}_${user}$(instConfSuffix "$inst")
	CONF=$confBase.ovpn
	CONNCONF=${confBase}_connect.ovpn

	inst_addr=$(inst_var $inst addr)
	inst_port=$(inst_var $inst port)
	inst_proto=$(inst_var $inst proto)
	inst_mode=$(inst_var $inst auth_mode)

	if [ ! -s $CONF ]; then
		>$CONF
		echo "client"			>>$CONF
		echo "dev		tun"		>>$CONF
		echo "port		$inst_port"	>>$CONF
		echo "proto		$inst_proto"	>>$CONF
		echo "remote	$inst_addr"	>>$CONF
		echo "<ca>"			>>$CONF
		cat		$ovpndir/ca.pem		>>$CONF
		echo "</ca>"			>>$CONF
		echo "<cert>"			>>$CONF
		cat		$certfile		>>$CONF
		echo "</cert>"			>>$CONF
		echo "<key>"			>>$CONF
		cat		$keyfile		>>$CONF
		echo "</key>"			>>$CONF
		echo "<tls-auth>"		>>$CONF
		cat		$ovpndir/ta.key		>>$CONF
		echo "</tls-auth>"		>>$CONF
		echo "tls-client"		>>$CONF
		echo "cipher $cipher"		>>$CONF
		echo "data-ciphers $cipher"	>>$CONF
		echo "resolv-retry infinite">>$CONF
		echo "persist-key"		>>$CONF
		echo "persist-tun"		>>$CONF
		if [ "$inst_mode" = "2fa" ]; then
			echo "auth-user-pass"	>>$CONF
			echo "auth-nocache"	>>$CONF
			echo "reneg-sec 0"	>>$CONF
		fi
		cp $CONF ${CONF%.ovpn}.conf
	else
		echo "conf file already exists"
	fi

	#дополнительный конфиг для OpenVPN Connect (makeConnectConf=1 в _config):
	#remote одной строкой с портом и протоколом; tls-auth без key-direction,
	#как и в основном конфиге (сервер базового варианта - двунаправленный)
	if [ "$makeConnectConf" = "1" ]; then
		if [ ! -s $CONNCONF ]; then
			>$CONNCONF
			echo "client"						>>$CONNCONF
			echo "dev tun"						>>$CONNCONF
			echo "remote $inst_addr $inst_port $inst_proto"	>>$CONNCONF
			echo "tls-client"					>>$CONNCONF
			echo "nobind"						>>$CONNCONF
			echo "cipher $cipher"					>>$CONNCONF
			echo "data-ciphers $cipher"				>>$CONNCONF
			echo "resolv-retry infinite"				>>$CONNCONF
			echo "persist-key"					>>$CONNCONF
			echo "persist-tun"					>>$CONNCONF
			if [ "$inst_mode" = "2fa" ]; then
				echo "auth-user-pass"				>>$CONNCONF
				echo "auth-nocache"				>>$CONNCONF
				echo "reneg-sec 0"				>>$CONNCONF
			fi
			echo "<ca>"						>>$CONNCONF
			cat $ovpndir/ca.pem					>>$CONNCONF
			echo "</ca>"						>>$CONNCONF
			echo "<cert>"						>>$CONNCONF
			cat $certfile						>>$CONNCONF
			echo "</cert>"						>>$CONNCONF
			echo "<key>"						>>$CONNCONF
			cat $keyfile						>>$CONNCONF
			echo "</key>"						>>$CONNCONF
			echo "<tls-auth>"					>>$CONNCONF
			cat $ovpndir/ta.key					>>$CONNCONF
			echo "</tls-auth>"					>>$CONNCONF
		else
			echo "connect conf already exists"
		fi
	fi

	# fetching IP
	if [ -n "$inventoryApiUrl" ]; then
		ip=`grep -vE '^#' $ccd | grep 'ifconfig-push' | head -n 1 | cut -d' ' -f2`
		if [ -n "$ip" ]; then
			inv_prefix=$(inst_var $inst inv_prefix)
			inventorySetIpInfo $ip ${inv_prefix}${user}
			inventoryAttachUserIp $user $ip
		fi
	fi
done

#генерация секрета Google Authenticator (2FA): есть хоть один 2FA-инстанс
#(в одиночном режиме - use2fa=1)
if [ "$need2fa" = "1" ]; then
	if [ -s $goofile ]; then
		echo "Файл Google-auth - ОК (уже есть)"
	else
		# -t --time-based
		# -f --force
		# -r --rate-limit=5 - не больше 5 попыток
		# -R --rate-time=30 - за каждые 60 секунд
		# -w --windows-size - разрешить входить по 5 предыдущим и 5 следующим ключам
		# -S --step-size=60 - новый ключ каждые 60 секунд
		# -Q --qr-mode=none - не выводить QR код
		# -D --allow-reuse  - разрешить 2 раза входить по одному и тому же ключу
		# -q --quiet
		google-authenticator -f -t -r 3 -R 30 -w 5 -Q none -D -q --secret=$goofile
		echo "Файл Google-auth - ОК"
	fi
fi

header="#!/bin/bash"

echo -e "$header\n$ovpndir/usr.enable $user \$*" > $userdir/_enable
chmod 755 $userdir/_enable

echo -e "$header\n$ovpndir/usr.disable $user \$*" > $userdir/_disable
chmod 755 $userdir/_disable

echo -e "$header\n$ovpndir/usr.new $user \$*" > $userdir/_renew
chmod 755 $userdir/_renew

echo -e "$header\n$ovpndir/usr.send $user \$*" > $userdir/_send
chmod 755 $userdir/_send
