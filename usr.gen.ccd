#!/bin/bash
#генерирует/обновляет CCD файл клиента для инстанса
#использование: usr.gen.ccd <user> [instance] [noupdate]
# instance  - инстанс доступа: сеть из <instance>_lan, маршруты из
#             <instance>_routes, IP закрепляется по <instance>_inv_prefix.
#             Без инстанса в одиночном режиме - дефолтный "local" (ccd).
# noupdate  - не трогать существующий CCD
#
#существующий CCD сверяется по md5 с предыдущей (previous*) и текущей
#конфигурацией сети: стандартный старый - обновляется, кастомный - не
#трогается (рядом кладутся ccd.new/ccd.old)

if [ -z "$1" ]; then
	echo "No username given"
	exit
fi

#подключаем конфиг и либы
SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib
. $SCRIPTPATH/_lib.inv

#грузим пользователя
user=$1
shift

#грузим остальные параметры
instance=""
noupdate=""
for arg in "$@"; do
	if [ "$arg" == "noupdate" ]; then
		noupdate=1
	else
		instance=$arg
	fi
done

#без инстанса - дефолтный "local" (в одиночном режиме его атрибуты - legacy-переменные)
instance="${instance:-local}"

net=$(inst_var $instance lan)
routes=$(inst_var $instance routes)
prvnet=$(inst_var $instance previous_lan)
prvnet=${prvnet:-$net}
prvroutes=$(inst_var $instance previous_routes)
prvroutes=${prvroutes:-$routes}

if [ -z "$net" ]; then
	echo "HALT: no <instance>_lan in _config! (instance=$instance)"
	exit 10
fi

userdir=$(getConfigDir $user)
ccd=$(getConfigCcd $user $instance)

#отключенный CCD обновляем на месте (он останется отключенным)
if [ ! -s "$ccd" ] && [ -s "$ccd.disabled" ]; then
	ccd=$ccd.disabled
fi

mkdir -p $userdir

if [ -s $ccd ] && [ -n "$noupdate" ]; then
	echo "CCD file already exists"
	exit 0
fi

inv_prefix=$(inst_var $instance inv_prefix)

prv=`mktemp`
new=`mktemp`
if [ -n "$inventoryApiUrl" ]; then
	echo "Fetching reserved IP for ${inv_prefix}${user}"

	addr=`inventoryGetPinnedIp ${inv_prefix}${user}`
	if [ "$addr" == "null" ]; then
		echo "ERR fetching reserved addr."
		echo "Fetching first unused IP in $net"
		addr=`inventoryGetUnusedIp $net`
		if [ "$addr" == "null" ]; then
			echo "HALT: ERR fetching unused IP!"
			exit 10
		fi
	fi
	if [ -z "$addr" ]; then
		echo "HALT: error fetching user IP!"
		exit 10
	fi

	#адрес хранится без подсети - конвертируем в "адрес маска"
	prvMask=`networkSuffix $prvnet`
	mask=`networkSuffix $net`
	prvAddr=`suffix2mask $addr/$prvMask`
	addr=`suffix2mask $addr/$mask`
	echo "got $addr"

	echo "ifconfig-push $prvAddr" > $prv
	echo "ifconfig-push $addr" > $new
else
	echo "Creating empty CCD"
	touch $prv
	touch $new
fi

echo "push \"route `suffix2mask $prvnet`\"" >> $prv
echo "push \"route `suffix2mask $net`\"" >> $new

for netw in $prvroutes; do
	echo "push \"route `suffix2mask $netw`\"" >> $prv
done
for netw in $routes; do
	echo "push \"route `suffix2mask $netw`\"" >> $new
done

prvmd5=$(md5sum "$prv" | cut -d ' ' -f 1)
newmd5=$(md5sum "$new" | cut -d ' ' -f 1)
if [ -s $ccd ]; then
	curmd5=$(md5sum "$ccd" | cut -d ' ' -f 1)
	if [ "$curmd5" == "$newmd5" ]; then
		echo "no CCD changes ($user)"
	else
		if [ "$curmd5" == "$prvmd5" ]; then
			echo "CCD version updating ($user)"
			cp -f $new $ccd
		else
			echo "WARNING: custom CCD - no changes! ($user)"
			cp -f $new $ccd.new
			cp -f $prv $ccd.old
		fi
	fi
else
	cp -f $new $ccd
fi
rm -f $new
rm -f $prv
