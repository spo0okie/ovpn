#!/bin/bash
#генерирует bash-файл с переменными <CN><ccd_suffix>=<ip>: имя переменной
#повторяет имя CCD-файла в профиле (ccd.2fa -> <CN>_2fa), см. ccdVarName в _lib
#обход идет по папкам-профилям пользователей (clients/<prefix>-<user>), а не по
#каталогам публикации CCD: иначе в списке не будет отключенных пользователей
#(CCD лежит как <ccd>.disabled), и генератор iptables не узнает про их адреса.
#использование: usr.ccd2env [output_file]
#без output_file - вывод в stdout

SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )" #"
. $SCRIPTPATH/_config
. $SCRIPTPATH/_lib

output=${1:-}

if [ -n "$output" ]; then
	echo "#!/bin/bash" > "$output"
	echo "# Auto-generated VPN user IP assignments" >> "$output"
	echo "# Generated on $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$output"
	echo "" >> "$output"
fi

for instance in $(getInstances); do
	for d in ${clientsDir:-$ovpndir/clients}/$prefix-*; do
		[ -d "$d" ] || continue
		user=${d##*/$prefix-}
		#getCcdIp сам заглядывает в $ccd.disabled, если активного CCD нет
		ip=$(getCcdIp "$(getConfigCcd "$user" "$instance")")
		[ -n "$ip" ] && echo "$(ccdVarName "$user" "$instance")=${ip}"
	done
done >> "${output:-/dev/stdout}"

#код выхода цикла - от последней проверки [ -n "$ip" ], а у последнего профиля
#CCD на этом инстансе может и не быть: отсутствие адреса ошибкой не считаем
exit 0
